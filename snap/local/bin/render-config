#!/bin/sh
# SPDX-FileCopyrightText: 2026 Euro-Office contributors
# SPDX-License-Identifier: AGPL-3.0-only
# Writes the configuration files from the snap options, creating missing secrets.
set -eu
. "$SNAP/bin/common.sh"
umask 077

secret() {
    value=$(snapctl get "$1")
    if [ -z "$value" ]; then
        value=$(tr -dc A-Za-z0-9 </dev/urandom | head -c 48)
        snapctl set "$1=$value"
    fi
    printf %s "$value"
}

option() {
    value=$(snapctl get "$1")
    printf %s "${value:-$2}"
}

JWT_SECRET=$(secret jwt.secret)
LINK_SECRET=$(secret private.link-secret)
RABBIT_SECRET=$(secret private.rabbitmq-secret)
SESSION_SECRET=$(secret private.session-secret)
PORT=$(option port 8480)
WORKERS=$(option workers 2)
ADDRESS=$(option address 127.0.0.1)

case $PORT in *[!0-9]*) echo "port must be a number" >&2; exit 1 ;; esac
case $WORKERS in 0 | *[!0-9]*) echo "workers must be a positive number" >&2; exit 1 ;; esac
case $ADDRESS in *[!0-9.]*) echo "address must be an IPv4 address" >&2; exit 1 ;; esac
case $JWT_SECRET in *[!A-Za-z0-9_.-]*) echo "jwt.secret may only contain A-Z a-z 0-9 _ . -" >&2; exit 1 ;; esac
[ "${#JWT_SECRET}" -ge 32 ] || { echo "jwt.secret needs at least 32 characters" >&2; exit 1; }

for dir in "$RUN" "$SNAP_DATA/home" "$SNAP_COMMON/data" "$SNAP_COMMON/lib/documentserver" \
    "$SNAP_COMMON/log/documentserver" "$SNAP_COMMON/postgresql" "$SNAP_COMMON/rabbitmq"; do
    service_dir "$dir"
done
mkdir -p "$CONFIG" "$SNAP_COMMON/connection"
chmod 755 "$CONFIG"

# The server multiplies this by the number of CPUs and rounds up.
WORKERS_PER_CPU=$(awk -v w="$WORKERS" -v c="$(grep -c ^processor /proc/cpuinfo)" 'BEGIN { printf "%d.%04d", int(w / c), int(w / c * 10000) % 10000 }')

render() {
    sed -e "s|@JWT_SECRET@|$JWT_SECRET|g" -e "s|@LINK_SECRET@|$LINK_SECRET|g" \
        -e "s|@RABBIT_SECRET@|$RABBIT_SECRET|g" -e "s|@SESSION_SECRET@|$SESSION_SECRET|g" \
        -e "s|@WORKERS_PER_CPU@|$WORKERS_PER_CPU|g" -e "s|@PORT@|$PORT|g" -e "s|@ADDRESS@|$ADDRESS|g" -e "s|@RUN@|$RUN|g" \
        -e "s|@SNAP@|/snap/$SNAP_INSTANCE_NAME/current|g" -e "s|@COMMON@|$SNAP_COMMON|g" \
        "$SNAP/config/$1" >"$2.new"
    if [ "${3:-}" ]; then chown "$3:$3" "$2.new"; fi
    mv -f "$2.new" "$2"
}

render local.json "$CONFIG/local.json" _daemon_
render nginx.conf "$CONFIG/nginx.conf" _daemon_
render rabbitmq.conf "$CONFIG/rabbitmq.conf" _daemon_

# Root only: the connected snap reads this.
render connection.json "$SNAP_COMMON/connection/connection.json"
